# Generate the Cloudflare Worker from the generic framework adapter and the
# reviewed catalog. This file is intentionally Kujo-authored.
from src.catalog import load_catalog
from src.protocol import SERVER_VERSION, handle_jsonrpc
from src.registry import list_tools, list_resources, list_prompts, read_resource, get_prompt, call_tool

func option_value(argv, name, fallback) {
    idx := 0
    while idx < len(argv) {
        if argv[idx] == name && idx + 1 < len(argv) { return to_string(argv[idx + 1]) }
        idx := idx + 1
    }
    return fallback
}

argv := args()
framework_value := option_value(argv, "--framework", "../mcp")
framework_root := framework_value
if starts_with(framework_root, "/") == false { framework_root = path_join(os_getcwd(), framework_root) }
template_path := path_join(framework_root, "src/cloudflare/worker_template.js")
catalog_path := option_value(argv, "--catalog", "data/catalog.json")
if starts_with(catalog_path, "/") == false { catalog_path = path_join(os_getcwd(), catalog_path) }
output_path := option_value(argv, "--out", "dist/worker.js")
if starts_with(output_path, "/") == false { output_path = path_join(os_getcwd(), output_path) }
assert(file_exists(template_path), "Cloudflare Worker template not found: " + template_path)
catalog := load_catalog(catalog_path)
catalog["server_version"] := SERVER_VERSION
resources := {}
for resource in list_resources() { resources[resource["uri"]] := read_resource(catalog, resource["uri"])["contents"] }
installations := {}
for profile in ["default", "core", "agent", "ai", "quality", "showcases", "operating", "all"] {
    installations[profile] := call_tool(catalog, "get_installation", {"profile": profile})["result"]["structuredContent"]
}
prompt_templates := {}
for prompt in list_prompts() {
    rendered := get_prompt(prompt["name"], {"task": "__KUJO_TASK__"})
    prompt_templates[prompt["name"]] := {"description": split(rendered["description"], "__KUJO_TASK__")[0], "prefix": split(rendered["messages"][0]["content"]["text"], "__KUJO_TASK__")[0]}
}
catalog["registry"] := {"tools": list_tools(), "resources": list_resources(), "prompts": list_prompts(), "resource_contents": resources, "prompt_templates": prompt_templates, "installations": installations, "overview": call_tool(catalog, "get_kujo_overview", {})["result"]["structuredContent"], "discovery": handle_jsonrpc(catalog, {"jsonrpc": "2.0", "id": 1, "method": "server/discover"})["result"]}
template := read_file(template_path)
assert(index_of(template, "__KUJO_MCP_DATA__") >= 0, "Worker template is missing the catalog marker")
telemetry := read_file("src/cloudflare/vendor/access-jose.js") + "\n" + read_file("src/cloudflare/telemetry.js")
telemetry = replace(telemetry, "__ANALYTICS_HTML__", to_json(read_file("src/cloudflare/dashboard.html")))
telemetry = replace(telemetry, "__ANALYTICS_JS__", to_json(read_file("src/cloudflare/vendor/dashboard-bundle.js")))
telemetry = replace(telemetry, "__ANALYTICS_NOTICE__", to_json(read_file("docs/TELEMETRY.md")))
# Fail closed on template drift rather than silently drop instrumentation.
assert(index_of(template, "export default {async fetch(request){") >= 0, "Worker entry point changed")
assert(index_of(template, "  const result=handle(p);") >= 0, "Worker dispatch changed")
worker := replace(template, "__KUJO_MCP_DATA__", to_json(catalog))
worker = replace(worker, "export default {async fetch(request){", telemetry + "\nexport default {scheduled(_event,env,ctx){ctx.waitUntil(analyticsCleanup(env));},async fetch(request,env,ctx){")
worker = replace(worker, "  if(request.headers.has('origin'))", "  const analyticsPage=await analyticsRoute(request,env,ctx);if(analyticsPage)return analyticsPage;\n  if(request.headers.has('origin'))")
worker = replace(worker, "  const result=handle(p);", "  const analyticsStart=performance.now();const result=handle(p);analyticsRecord(request,env,ctx,p,result,performance.now()-analyticsStart);")
create_dir(dirname(output_path))
write_file(output_path, worker, true)
write_file(output_path + ".sha256", sha256(worker) + "\n", true)

fixtures := [
    {"name":"initialize","request":{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2026-07-28"}}},
    {"name":"ping","request":{"jsonrpc":"2.0","id":2,"method":"ping","params":{}}},
    {"name":"tools-list","request":{"jsonrpc":"2.0","id":3,"method":"tools/list","params":{}}},
    {"name":"overview","request":{"jsonrpc":"2.0","id":4,"method":"tools/call","params":{"name":"get_kujo_overview","arguments":{}}}},
    {"name":"search","request":{"jsonrpc":"2.0","id":5,"method":"tools/call","params":{"name":"search_kujo_catalog","arguments":{"query":"MCP agent gateway","limit":5}}}},
    {"name":"item","request":{"jsonrpc":"2.0","id":6,"method":"tools/call","params":{"name":"get_catalog_item","arguments":{"slug":"kujo"}}}},
    {"name":"resources-list","request":{"jsonrpc":"2.0","id":7,"method":"resources/list","params":{}}},
    {"name":"installation","request":{"jsonrpc":"2.0","id":8,"method":"tools/call","params":{"name":"get_installation","arguments":{"profile":"core"}}}},
    {"name":"prompts-list","request":{"jsonrpc":"2.0","id":9,"method":"prompts/list","params":{}}},
    {"name":"invalid-method","request":{"jsonrpc":"2.0","id":10,"method":"nope","params":{}}}
]
fixtures_json := to_json_pretty({"catalog_revision":catalog["source"]["snapshot_sha256"],"fixtures":fixtures}) + "\n"
write_file(path_join(dirname(output_path), "parity-fixtures.json"), fixtures_json, true)
write_file(path_join(dirname(output_path), "generation.json"), to_json_pretty({
    "generator": "kujolang-mcp/scripts/generate_worker.kujo",
    "generator_version": "3",
    "telemetry_bundle_sha256": sha256(telemetry),
    "generator_sha256": sha256(read_file("scripts/generate_worker.kujo")),
    "registry_source_sha256": sha256(read_file("src/registry.kujo")),
    "catalog_source_sha256": sha256(read_file("src/catalog.kujo")),
    "json_numbers_source_sha256": sha256(read_file("src/json_numbers.kujo")),
    "protocol_source_sha256": sha256(read_file("src/protocol.kujo")),
    "build_inputs": parse_json(read_file("build-inputs.json")),
    "framework": "kujolang/mcp",
    "framework_template": "src/cloudflare/worker_template.js",
    "catalog": "data/catalog.json",
    "catalog_revision": catalog["source"]["snapshot_sha256"],
    "catalog_content_digest": catalog["source"]["content_sha256"],
    "template_sha256": sha256(template),
    "parity_fixtures_sha256": sha256(fixtures_json),
    "worker_sha256": sha256(worker),
    "generated_from": "Kujo source and reviewed catalog"
}) + "\n", true)
print(to_json({"ok":true,"worker":output_path,"catalog_revision":catalog["source"]["snapshot_sha256"],"worker_sha256":sha256(worker),"bytes":len(worker)}))
