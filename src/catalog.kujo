export func has_field(value, name) {
    probe := has_key(value, name)
    if type(probe) == "bool" { return probe }
    if type(probe) == "int" { return probe == 1 }
    return false
}

export func load_catalog(path) {
    assert(file_exists(path), "Catalog file not found: " + path)
    parsed := parse_json(read_file(path))
    assert(type(parsed) == "dict", "Catalog must be a JSON object")
    assert(has_field(parsed, "schema_version"), "Catalog schema_version is required")
    assert(parsed["schema_version"] == "kujolang-mcp/catalog-v1", "Unsupported catalog schema")
    assert(has_field(parsed, "source") && type(parsed["source"]) == "dict", "Catalog source must be an object")
    assert(has_field(parsed["source"], "content_sha256") && type(parsed["source"]["content_sha256"]) == "string", "Catalog source content_sha256 is required")
    assert(has_field(parsed["source"], "snapshot_sha256") && type(parsed["source"]["snapshot_sha256"]) == "string", "Catalog source snapshot_sha256 is required")
    assert(has_field(parsed, "installation") && type(parsed["installation"]) == "dict", "Catalog installation must be an object")
    assert(has_field(parsed, "counts") && type(parsed["counts"]) == "dict", "Catalog counts must be an object")
    assert(has_field(parsed, "items") && type(parsed["items"]) == "array", "Catalog items must be an array")

    search_index := []
    seen_slugs := {}
    projects := 0
    skills := 0
    workflows := 0
    item_index := 0
    for item in parsed["items"] {
        assert(type(item) == "dict", "Catalog item " + to_string(item_index) + " must be an object")
        for field in ["kind", "slug", "title", "description", "category", "keywords", "launch_story"] {
            assert(has_field(item, field) && type(item[field]) == "string", "Catalog item " + to_string(item_index) + " field " + field + " must be a string")
        }
        assert(has_field(item, "tags") && type(item["tags"]) == "array", "Catalog item " + to_string(item_index) + " tags must be an array")
        slug := trim(item["slug"])
        assert(slug != "", "Catalog item " + to_string(item_index) + " slug must not be empty")
        assert(has_field(seen_slugs, slug) == false, "Duplicate catalog slug: " + slug)
        seen_slugs[slug] := true
        kind := item["kind"]
        assert(kind == "project" || kind == "skill" || kind == "workflow", "Unsupported catalog kind: " + kind)
        if kind == "project" { projects = projects + 1 }
        if kind == "skill" { skills = skills + 1 }
        if kind == "workflow" { workflows = workflows + 1 }
        search_index = push(search_index, {
            "search": item_search_text(item),
            "identity": normalized(item["title"] + " " + item["slug"]),
            "slug": normalized(item["slug"]),
            "title": normalized(item["title"])
        })
        item_index = item_index + 1
    }
    assert(parsed["counts"]["projects"] == projects, "Catalog project count is inconsistent")
    assert(parsed["counts"]["skills"] == skills, "Catalog skill count is inconsistent")
    assert(parsed["counts"]["workflows"] == workflows, "Catalog workflow count is inconsistent")
    assert(parsed["counts"]["total"] == len(parsed["items"]), "Catalog total count is inconsistent")
    assert(parsed["source"]["content_sha256"] == sha256(to_json(parsed["items"])), "Catalog content digest is inconsistent")
    snapshot := {"installation": parsed["installation"], "items": parsed["items"]}
    assert(parsed["source"]["snapshot_sha256"] == sha256(to_json(snapshot)), "Catalog snapshot digest is inconsistent")
    parsed["_search_index"] := search_index
    return parsed
}

func normalized(value) {
    text := to_lower(trim(to_string(value)))
    for character in ["-", "_", "/", ".", ",", ":", ";", "(", ")", "[", "]", "`"] {
        text = replace(text, character, " ")
    }
    return regex_replace(text, "\\s+", " ")
}

func item_search_text(item) {
    tags := ""
    if has_field(item, "tags") && type(item["tags"]) == "array" { tags = join(item["tags"], " ") }
    return normalized(item["slug"] + " " + item["title"] + " " + item["description"] + " " + item["category"] + " " + tags + " " + item["keywords"] + " " + item["launch_story"])
}

func is_stop_term(term) {
    for stop in ["a", "an", "and", "for", "from", "in", "of", "on", "or", "the", "to", "with"] {
        if term == stop { return true }
    }
    return false
}

func matches_filter(item, kind, category) {
    if kind != "" && to_lower(item["kind"]) != to_lower(kind) { return false }
    if category != "" && index_of(to_lower(item["category"]), to_lower(category)) < 0 { return false }
    return true
}

func public_item(item) {
    return {
        "kind": item["kind"], "slug": item["slug"], "title": item["title"],
        "description": item["description"], "category": item["category"], "tags": item["tags"],
        "install_command": item["install_command"], "github_url": item["github_url"],
        "website_url": item["website_url"], "scope_note": item["scope_note"],
        "version": item["version"], "last_updated": item["last_updated"]
    }
}

export func list_catalog_items(catalog, kind, category, limit) {
    output := []
    for item in catalog["items"] {
        if matches_filter(item, kind, category) {
            output = push(output, public_item(item))
            if len(output) >= limit { break }
        }
    }
    return output
}

export func find_catalog_item(catalog, slug) {
    wanted := normalized(slug)
    idx := 0
    while idx < len(catalog["items"]) {
        search_entry := catalog["_search_index"][idx]
        if search_entry["slug"] == wanted || search_entry["title"] == wanted { return public_item(catalog["items"][idx]) }
        idx = idx + 1
    }
    return null
}

func bounded_unique_terms(query) {
    output := []
    for term in split(normalized(query), " ") {
        if len(term) < 2 || is_stop_term(term) || index_of(output, term) >= 0 { continue }
        output = push(output, term)
        if len(output) >= 24 { break }
    }
    return output
}

func search_catalog_internal(catalog, query, kind, category, slug_prefix, limit) {
    terms := bounded_unique_terms(query)
    scored := []
    idx := 0
    while idx < len(catalog["items"]) {
        item := catalog["items"][idx]
        search_entry := catalog["_search_index"][idx]
        idx = idx + 1
        if matches_filter(item, kind, category) == false { continue }
        if slug_prefix != "" && starts_with(item["slug"], slug_prefix) == false { continue }
        haystack := search_entry["search"]
        score := 0
        matched_terms := []
        for term in terms {
            if index_of(haystack, term) >= 0 {
                score = score + 1
                matched_terms = push(matched_terms, term)
                if index_of(search_entry["identity"], term) >= 0 { score = score + 2 }
            }
        }
        if score > 0 {
            scored = push(scored, {"score": score, "matched_terms": matched_terms, "item": public_item(item)})
        }
    }
    # Catalogs are small; deterministic selection avoids external sort helpers.
    output := []
    while len(output) < limit && len(scored) > 0 {
        best_index := 0
        idx := 1
        while idx < len(scored) {
            if scored[idx]["score"] > scored[best_index]["score"] { best_index = idx }
            idx = idx + 1
        }
        output = push(output, scored[best_index])
        remaining := []
        idx = 0
        while idx < len(scored) {
            if idx != best_index { remaining = push(remaining, scored[idx]) }
            idx = idx + 1
        }
        scored = remaining
    }
    return output
}

export func search_catalog(catalog, query, kind, category, limit) {
    return search_catalog_internal(catalog, query, kind, category, "", limit)
}

export func search_catalog_prefix(catalog, query, kind, category, slug_prefix, limit) {
    return search_catalog_internal(catalog, query, kind, category, slug_prefix, limit)
}

export func catalog_summary(catalog) {
    return {
        "name": catalog["source"]["name"], "url": catalog["source"]["url"],
        "source_version": catalog["source"]["version"], "catalog_revision": catalog["source"]["snapshot_sha256"], "counts": catalog["counts"],
        "categories": ["Primitives", "Tooling", "Showcase", "Agent Skill", "Workflow"],
        "default_install_command": catalog["installation"]["default_command"]
    }
}
