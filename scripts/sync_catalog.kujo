from src.catalog_source import sync_catalog

# Thin CLI for deterministic Kujolang.ai catalog synchronization.

func option_value(argv, name, fallback) {
    idx := 0
    while idx < len(argv) {
        if argv[idx] == name && idx + 1 < len(argv) { return to_string(argv[idx + 1]) }
        idx := idx + 1
    }
    return fallback
}

func has_option(argv, name) {
    for value in argv { if value == name { return true } }
    return false
}

argv := args()
site_root := path_absolute(option_value(argv, "--site", "../../kujolang.ai"))
output_path := option_value(argv, "--out", "data/catalog.json")
if starts_with(output_path, "/") == false { output_path = path_join(os_getcwd(), output_path) }
check_only := has_option(argv, "--check")
json_output := has_option(argv, "--json")
result := sync_catalog(site_root, output_path, check_only)
catalog := result["catalog"]
mode := "refresh"
if check_only { mode = "check" }
receipt := {
    "ok": true, "mode": mode, "changed": result["changed"],
    "catalog_path": result["catalog_path"], "source_version": catalog["source"]["version"],
    "catalog_revision": catalog["source"]["snapshot_sha256"], "counts": catalog["counts"]
}
if json_output { print(to_json(receipt)) }
else if check_only { print("Catalog is current: " + to_string(catalog["counts"]["total"]) + " entries") }
else if result["changed"] { print("Wrote " + output_path + " with " + to_string(catalog["counts"]["total"]) + " entries") }
else { print("Catalog already current: " + to_string(catalog["counts"]["total"]) + " entries") }
