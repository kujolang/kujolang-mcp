export func has_field(value, name) {
    probe := has_key(value, name)
    if type(probe) == "bool" { return probe }
    if type(probe) == "int" { return probe == 1 }
    return false
}

func safe_text(value) {
    return regex_match(value, "[\\x00-\\x08\\x0b\\x0c\\x0e-\\x1f\\x7f\\x{200b}-\\x{200f}\\x{202a}-\\x{202e}\\x{2066}-\\x{2069}\\x{feff}]") == false
}

func validate_text(parent, field, maximum) {
    assert(has_field(parent, field) && type(parent[field]) == "string", "Catalog field " + field + " must be a string")
    assert(len(parent[field]) <= maximum && safe_text(parent[field]), "Catalog field exceeds length or contains invisible controls: " + field)
}

export func load_catalog(path) {
    assert(file_exists(path), "Catalog file not found: " + path)
    parsed := parse_json(read_file(path))
    return validate_catalog(parsed)
}

export func validate_catalog(parsed) {
    assert(type(parsed) == "dict", "Catalog must be a JSON object")
    assert(has_field(parsed, "schema_version"), "Catalog schema_version is required")
    assert(parsed["schema_version"] == "kujolang-mcp/catalog-v1", "Unsupported catalog schema")
    assert(has_field(parsed, "source") && type(parsed["source"]) == "dict", "Catalog source must be an object")
    assert(has_field(parsed["source"], "content_sha256") && type(parsed["source"]["content_sha256"]) == "string", "Catalog source content_sha256 is required")
    assert(has_field(parsed["source"], "snapshot_sha256") && type(parsed["source"]["snapshot_sha256"]) == "string", "Catalog source snapshot_sha256 is required")
    assert(has_field(parsed, "installation") && type(parsed["installation"]) == "dict", "Catalog installation must be an object")
    assert(has_field(parsed, "counts") && type(parsed["counts"]) == "dict", "Catalog counts must be an object")
    assert(has_field(parsed, "items") && type(parsed["items"]) == "array", "Catalog items must be an array")

    assert(len(parsed["items"]) <= 50000, "Catalog exceeds maximum item count")
    for key in keys(parsed) { assert(index_of(["schema_version", "source", "counts", "installation", "items"], key) >= 0, "Unexpected catalog property") }
    for key in keys(parsed["source"]) { assert(index_of(["name", "url", "repository", "version", "content_sha256", "snapshot_sha256"], key) >= 0, "Unexpected catalog source property") }
    for key in keys(parsed["counts"]) { assert(index_of(["projects", "skills", "workflows", "total"], key) >= 0, "Unexpected catalog count property") }
    for key in keys(parsed["installation"]) { assert(index_of(["default_command", "source_command", "all_command", "profile_commands", "profiles"], key) >= 0, "Unexpected installation property") }
    for field in ["name", "url", "repository", "version", "content_sha256", "snapshot_sha256"] { validate_text(parsed["source"], field, 256) }
    assert(parsed["source"]["url"] == "https://kujolang.ai", "Unexpected catalog source")
    assert(parsed["source"]["repository"] == "https://github.com/kujolang/kujolang.ai", "Unexpected catalog repository")
    for field in ["projects", "skills", "workflows", "total"] { assert(has_field(parsed["counts"], field) && type(parsed["counts"][field]) == "int", "Catalog count must be an integer") }
    install := parsed["installation"]
    for field in ["default_command", "all_command", "source_command"] { validate_text(install, field, 4096) }
    for field in ["profiles", "profile_commands"] { assert(has_field(install, field) && type(install[field]) == "dict", "Installation profiles must be objects") }
    assert(len(keys(install["profiles"])) <= 32, "Too many installation profiles")
    for profile in ["core", "agent", "ai", "quality", "showcases", "operating"] {
        assert(has_field(install["profiles"], profile) && has_field(install["profile_commands"], profile), "Missing installation profile")
    }
    for profile in keys(install["profiles"]) {
        assert(regex_match(profile, "^[a-z][a-z0-9-]{0,31}$"), "Invalid installation profile")
        validate_text(install["profile_commands"], profile, 4096)
        members := install["profiles"][profile]
        assert(type(members) == "array" && len(members) > 0 && len(members) <= 256, "Invalid installation membership")
        seen_members := {}
        for member in members {
            assert(type(member) == "string" && regex_match(member, "^[a-z0-9][a-z0-9-]{0,127}$"), "Invalid installation member")
            assert(has_field(seen_members, member) == false, "Duplicate installation member")
            seen_members[member] := true
        }
    }
    for profile in keys(install["profile_commands"]) { assert(has_field(install["profiles"], profile), "Unmatched installation command") }
    search_index := []
    seen_slugs := {}
    projects := 0
    skills := 0
    workflows := 0
    item_index := 0
    for item in parsed["items"] {
        assert(type(item) == "dict", "Catalog item " + to_string(item_index) + " must be an object")
        for field in ["kind", "slug", "title", "description", "category", "keywords", "launch_story", "install_command", "github_url", "website_url", "scope_note", "version", "last_updated", "source_path"] {
            validate_text(item, field, 8192)
        }
        assert(has_field(item, "tags") && type(item["tags"]) == "array", "Catalog item " + to_string(item_index) + " tags must be an array")
        assert(len(item["tags"]) <= 64, "Too many catalog tags")
        for tag in item["tags"] { assert(type(tag) == "string" && len(tag) <= 128 && safe_text(tag), "Invalid catalog tag") }
        for field in keys(item) {
            assert(index_of(["kind", "slug", "title", "description", "category", "keywords", "launch_story", "install_command", "github_url", "website_url", "scope_note", "version", "last_updated", "source_path", "tags", "latest_release_url", "release_status"], field) >= 0, "Unexpected catalog item property")
        }
        for field in ["latest_release_url", "release_status"] { if has_field(item, field) { validate_text(item, field, 8192) } }
        for field in ["github_url", "latest_release_url"] {
            if has_field(item, field) && item[field] != "" { assert(regex_match(item[field], "^https://github\\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_./%-]+$"), "Unexpected catalog URL") }
        }
        assert(starts_with(item["website_url"], "https://kujolang.ai/ecosystem/"), "Unexpected website URL")
        assert(regex_match(item["source_path"], "^content/(ecosystem|skills|workflows)/[a-z0-9-]+\\.md$"), "Invalid source provenance")
        slug := trim(item["slug"])
        assert(regex_match(slug, "^[a-z0-9][a-z0-9-]{0,127}$") && slug == item["slug"], "Invalid catalog slug")
        assert(slug != "", "Catalog item " + to_string(item_index) + " slug must not be empty")
        assert(has_field(seen_slugs, slug) == false, "Duplicate catalog slug: " + slug)
        seen_slugs[slug] := true
        kind := item["kind"]
        assert(kind == "project" || kind == "skill" || kind == "workflow", "Unsupported catalog kind: " + kind)
        if kind == "project" { projects = projects + 1 }
        if kind == "skill" { skills = skills + 1 }
        if kind == "workflow" { workflows = workflows + 1 }
        search_index = push(search_index, {
            "search": item_search_text(item),
            "identity": normalized(item["title"] + " " + item["slug"]),
            "slug": normalized(item["slug"]),
            "title": normalized(item["title"])
        })
        item_index = item_index + 1
    }
    assert(parsed["counts"]["projects"] == projects, "Catalog project count is inconsistent")
    assert(parsed["counts"]["skills"] == skills, "Catalog skill count is inconsistent")
    assert(parsed["counts"]["workflows"] == workflows, "Catalog workflow count is inconsistent")
    assert(parsed["counts"]["total"] == len(parsed["items"]), "Catalog total count is inconsistent")
    assert(parsed["source"]["content_sha256"] == sha256(to_json(parsed["items"])), "Catalog content digest is inconsistent")
    snapshot := {"installation": parsed["installation"], "items": parsed["items"]}
    assert(parsed["source"]["snapshot_sha256"] == sha256(to_json(snapshot)), "Catalog snapshot digest is inconsistent")
    parsed["_search_index"] := search_index
    return parsed
}

func normalized(value) {
    text := to_lower(trim(to_string(value)))
    for character in ["-", "_", "/", ".", ",", ":", ";", "(", ")", "[", "]", "`"] {
        text = replace(text, character, " ")
    }
    return regex_replace(text, "\\s+", " ")
}

func item_search_text(item) {
    tags := ""
    if has_field(item, "tags") && type(item["tags"]) == "array" { tags = join(item["tags"], " ") }
    return normalized(item["slug"] + " " + item["title"] + " " + item["description"] + " " + item["category"] + " " + tags + " " + item["keywords"] + " " + item["launch_story"])
}

func is_stop_term(term) {
    for stop in ["a", "an", "and", "for", "from", "in", "of", "on", "or", "the", "to", "with"] {
        if term == stop { return true }
    }
    return false
}

func matches_filter(item, kind, category) {
    if kind != "" && to_lower(item["kind"]) != to_lower(kind) { return false }
    if category != "" && index_of(to_lower(item["category"]), to_lower(category)) < 0 { return false }
    return true
}

func public_item(item) {
    release_url := ""
    release_status := ""
    if has_field(item, "latest_release_url") { release_url = item["latest_release_url"] }
    if has_field(item, "release_status") { release_status = item["release_status"] }
    return {
        "kind": item["kind"], "slug": item["slug"], "title": item["title"],
        "description": item["description"], "category": item["category"], "tags": item["tags"],
        "install_command": item["install_command"], "github_url": item["github_url"],
        "website_url": item["website_url"], "scope_note": item["scope_note"],
        "version": item["version"], "last_updated": item["last_updated"],
        "latest_release_url": release_url, "release_status": release_status,
        "source_path": item["source_path"], "provenance": "Reviewed committed Kujolang.ai content"
    }
}

export func list_catalog_items(catalog, kind, category, limit) {
    output := []
    for item in catalog["items"] {
        if matches_filter(item, kind, category) {
            output = push(output, public_item(item))
            if len(output) >= limit { break }
        }
    }
    return output
}

export func find_catalog_item(catalog, slug) {
    wanted := normalized(slug)
    idx := 0
    while idx < len(catalog["items"]) {
        search_entry := catalog["_search_index"][idx]
        if search_entry["slug"] == wanted || search_entry["title"] == wanted { return public_item(catalog["items"][idx]) }
        idx = idx + 1
    }
    return null
}

func bounded_unique_terms(query) {
    output := []
    for term in split(normalized(query), " ") {
        if len(term) < 2 || is_stop_term(term) || index_of(output, term) >= 0 { continue }
        output = push(output, term)
        if len(output) >= 24 { break }
    }
    return output
}

func search_catalog_internal(catalog, query, kind, category, slug_prefix, limit) {
    terms := bounded_unique_terms(query)
    scored := []
    idx := 0
    while idx < len(catalog["items"]) {
        item := catalog["items"][idx]
        search_entry := catalog["_search_index"][idx]
        idx = idx + 1
        if matches_filter(item, kind, category) == false { continue }
        if slug_prefix != "" && starts_with(item["slug"], slug_prefix) == false { continue }
        haystack := search_entry["search"]
        score := 0
        matched_terms := []
        for term in terms {
            if index_of(haystack, term) >= 0 {
                score = score + 1
                matched_terms = push(matched_terms, term)
                if index_of(search_entry["identity"], term) >= 0 { score = score + 2 }
            }
        }
        if score > 0 {
            # Keep only the best K candidates. Strict comparison retains source-order ties.
            if len(scored) == limit && score <= scored[len(scored) - 1]["score"] { continue }
            candidate := {"score": score, "matched_terms": matched_terms, "index": idx - 1}
            remaining := []
            inserted := false
            for existing in scored {
                if inserted == false && score > existing["score"] { remaining = push(remaining, candidate); inserted = true }
                if len(remaining) < limit { remaining = push(remaining, existing) }
            }
            if inserted == false && len(remaining) < limit { remaining = push(remaining, candidate) }
            scored = remaining
        }
    }
    output := []
    for candidate in scored {
        output = push(output, {"score": candidate["score"], "matched_terms": candidate["matched_terms"], "item": public_item(catalog["items"][candidate["index"]])})
    }
    return output
}

export func search_catalog(catalog, query, kind, category, limit) {
    return search_catalog_internal(catalog, query, kind, category, "", limit)
}

export func search_catalog_prefix(catalog, query, kind, category, slug_prefix, limit) {
    return search_catalog_internal(catalog, query, kind, category, slug_prefix, limit)
}

export func catalog_summary(catalog) {
    runtime_version := ""
    runtime_release_url := ""
    for item in catalog["items"] {
        if item["kind"] == "project" && item["slug"] == "kujo" {
            runtime_version = item["version"]
            if has_field(item, "latest_release_url") { runtime_release_url = item["latest_release_url"] }
        }
    }
    return {
        "name": catalog["source"]["name"], "url": catalog["source"]["url"],
        "source_version": catalog["source"]["version"], "runtime_version": runtime_version, "runtime_release_url": runtime_release_url, "catalog_revision": catalog["source"]["snapshot_sha256"], "counts": catalog["counts"],
        "categories": ["Primitives", "Tooling", "Showcase", "Agent Skill", "Workflow"],
        "default_install_command": catalog["installation"]["default_command"]
    }
}
