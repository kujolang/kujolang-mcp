{
  "name": "kujolang-mcp",
  "main": "dist/worker.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "mcp.kujolang.ai",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "kujolang-mcp-analytics",
      "database_id": "5adc4c4d-11a5-4733-9548-354231584e73",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ANALYTICS_ACCESS_AUD": "654934b8909ff4feaf514efd11475990e97e413eb73740ff34de4a4d0e196206"
  }
}
