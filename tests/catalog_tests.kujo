test_setup {
    from src.catalog import load_catalog, catalog_summary, list_catalog_items, find_catalog_item, search_catalog
}

test "catalog exposes released projects skills and workflows" {
    catalog := load_catalog("data/catalog.json")
    summary := catalog_summary(catalog)
    assert_true(summary["counts"]["projects"] > 0)
    assert_true(summary["counts"]["skills"] > 0)
    assert_true(summary["counts"]["workflows"] > 0)
    assert_equal(summary["counts"]["total"], len(catalog["items"]))
    assert_equal(summary["catalog_revision"], catalog["source"]["snapshot_sha256"])
    assert_equal(len(summary["catalog_revision"]), 64)
}

test "catalog installer profiles come from the website installer source" {
    from src.catalog_source import parse_installer_profiles
    source := "profile_catalog() {\n  cat <<'EOF'\ncore kujo kennel\nai mcp rag\nquality fence lens\nshowcases ssg cms\noperating kujo-skills kujo-workflows\nEOF\n}"
    profiles := parse_installer_profiles(source)
    assert_equal(profiles["core"], ["kujo", "kennel"])
    assert_equal(profiles["ai"], ["mcp", "rag"])
    assert_equal(profiles["operating"], ["kujo-skills", "kujo-workflows"])
}

test "catalog filtering and exact lookup preserve public guidance" {
    catalog := load_catalog("data/catalog.json")
    primitives := list_catalog_items(catalog, "project", "Primitives", 200)
    assert_true(len(primitives) >= 10)
    mcp := find_catalog_item(catalog, "mcp")
    assert_equal(mcp["title"], "MCP")
    assert_true(starts_with(mcp["github_url"], "https://github.com/kujolang/"))
    assert_true(len(mcp["scope_note"]) > 0)
}

test "catalog search returns deterministic relevant records" {
    catalog := load_catalog("data/catalog.json")
    results := search_catalog(catalog, "MCP agent gateway", "", "", 8)
    assert_true(len(results) > 0)
    assert_true(results[0]["score"] > 0)
    assert_true(len(results[0]["matched_terms"]) > 0)
}

test "webops catalog is available through released skill records" {
    catalog := load_catalog("data/catalog.json")
    results := search_catalog(catalog, "webops technical seo", "skill", "", 100)
    found := false
    for result in results {
        if result["item"]["slug"] == "webops-technical-seo" { found = true }
    }
    assert_true(found)
}

test "search deduplicates attacker-controlled repeated terms" {
    catalog := load_catalog("data/catalog.json")
    results := search_catalog(catalog, "mcp mcp mcp mcp", "", "", 5)
    assert_true(len(results) > 0)
    assert_equal(results[0]["matched_terms"], ["mcp"])
}
